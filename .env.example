# ---- required ----
DATABASE_URL=postgresql://user:password@host:5432/freblk
AUTH_SECRET=change-me-run-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Google (sign-in + Google Calendar). Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google . Enable "Google Calendar API".
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Microsoft (sign-in + Outlook/school calendar). Azure Portal → Entra ID → App registrations → New (multitenant + personal).
# Redirect URI (Web): {AUTH_URL}/api/auth/callback/microsoft-entra-id . API permissions: openid, email, profile, offline_access, Calendars.Read
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# ---- AI assistant (console.anthropic.com → API keys). Without it, Ask falls back to the built-in engine.
ANTHROPIC_API_KEY=

# ---- Push notifications: run `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Cron auth (Vercel cron sends this as a Bearer token)
CRON_SECRET=change-me
